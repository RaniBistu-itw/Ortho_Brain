APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ob1
DB_USERNAME=root
DB_PASSWORD=manager

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ─── Super admin seeded credentials ──────────────
SUPER_ADMIN_EMAIL=admin@orthobrain.local
SUPER_ADMIN_PASSWORD=Password@1

# ─── Admin branding ──────────────────────────────
ADMIN_BRAND_NAME=orthobrain
ADMIN_BRAND_TAGLINE="Orthodontics for Your Dental Practice"

# ─── Test doctor seeded credentials ──────────────
TEST_DOCTOR_EMAIL=doctor@orthobrain.local
TEST_DOCTOR_PASSWORD=Password@1

# ─── AI vision (photo QC + Perfect Smile Plan) ──────────────
# Provider chain walked in order. First available wins; others are fallbacks.
AI_PROVIDER_CHAIN=gemini,ollama,canned

# Primary — Google Gemini 2.0 Flash (free tier key from https://aistudio.google.com/apikey).
# NOTE: clinical photos leave the dev machine. OK for local demo; production needs BAA/legal review.
GEMINI_API_KEY=
AI_GEMINI_MODEL=gemini-2.0-flash

# Fallback 1 — Local Ollama (offline inference).
# Pre-req: `ollama pull moondream` and `ollama pull llava:7b`.
AI_OLLAMA_URL=http://localhost:11434
AI_OLLAMA_QC_MODEL=moondream
AI_OLLAMA_SMILE_MODEL=llava:7b
AI_OLLAMA_SMILE_TIMEOUT_SECONDS=90

# Global per-provider timeout (ms). Applies to QC + Gemini smile-plan calls.
AI_VISION_TIMEOUT_MS=15000

# Fallback 2 — canned responses only trigger for this exact case id.
# Leave blank to disable canned fallback entirely.
AI_DEMO_CASE_ID=